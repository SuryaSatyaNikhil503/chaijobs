{
  "name": "chaijobs",
  "version": "0.1.0",
  "description": "Your morning chai and today's jobs: an India-first daily job finder, filter and digest that runs free on GitHub Actions.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "chaijobs": "dist/cli.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuryaSatyaNikhil503/chaijobs.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
